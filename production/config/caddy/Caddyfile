{
    auto_https disable_redirects
    local_certs
}

(base) {
	# Catch all to prevent endpoint issues - Augusto
	handle /api/* {
		respond "Forbidden" 403
	}

	# Frontend
	handle {
		reverse_proxy sc-frontend:80
	}
}

(sc-api) {
	# Citizens Service
	@citizen_match {
		path /api/v1/citizen /api/v1/citizen/*
	}

	handle @citizen_match {
		reverse_proxy sc-citizens-service:8080
	}

	# Results Service
	@results_match {
		path /api/v1/results /api/v1/results/*
	}

	handle @results_match {
		reverse_proxy sc-results-service:8080
	}

	# Elections Service
	@elections_match {
		path /api/v1/elections /api/v1/elections/*
	}

	handle @elections_match {
		reverse_proxy sc-elections-service:8080
	}

	# Transparency Service
	@transparency_match {
		path /api/v1/transparency /api/v1/transparency/*
	}

	handle @transparency_match {
		reverse_proxy sc-transparency-service:8080
	}
}

(sr-api) {
	# Pre-elections Service (pre-electoral)
	@pre_elections_match {
		path /api/candidaturas /api/candidaturas/* /api/censo /api/censo/*
	}

	handle @pre_elections_match {
		reverse_proxy sr-pre-elections-service:8080
	}

	# Elections Service
	@elections_match {
		path /api/elecciones /api/elecciones/*
	}

	handle @elections_match {
		reverse_proxy sr-elections-service:8080
	}

	# Jury Mock Service
	@jury_match {
		path /api/jurados /api/jurados/*
	}

	handle @jury_match {
		reverse_proxy sr-mock-jury-service:8080
	}

	# Scrutiny Service
	@scrutiny_match {
		path /api/v1/e14 /api/v1/e14/*
	}

	handle @scrutiny_match {
		reverse_proxy sr-scrutiny-service:8080
	}
}

sello-legitimo.site {
    tls internal

	import sc-api
	import sr-api

	# Es importante que base este de ultimo - Augusto
	import base 
}

adminer.sello-legitimo.site {
    tls internal
    
    reverse_proxy adminer:8080 {
        header_up X-Forwarded-Proto {scheme}
    }
}
