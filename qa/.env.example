# =============================================================================
# QA Stack Environment Variables
# Upload this file in Portainer when creating or editing the stack.
# Path: Portainer UI -> Stacks -> sello-legitimo-qa -> Edit stack -> 
#       Environment variables -> Upload .env file
# =============================================================================

# --- Superuser ---
POSTGRES_SUPERUSER_PASSWORD=postgres

# --- SC Module: Citizens Service ---
SC_CITIZENS_DB_NAME=sc_citizen_db
SC_CITIZENS_DB_USER=sc_citizen_user
SC_CITIZENS_DB_PASSWORD=123456

# --- SC Module: Results Service ---
SC_RESULTS_DB_NAME=sc_results_db
SC_RESULTS_DB_USER=sc_results_user
SC_RESULTS_DB_PASSWORD=123456

# --- SC Module: Elections Service ---
SC_ELECTIONS_DB_NAME=sc_elections_db
SC_ELECTIONS_DB_USER=sc_elections_user
SC_ELECTIONS_DB_PASSWORD=123456

# --- SC Module: Transparency Service ---
SC_TRANSPARENCY_DB_NAME=sc_transparency_db
SC_TRANSPARENCY_DB_USER=sc_transparency_user
SC_TRANSPARENCY_DB_PASSWORD=123456

# --- SR Module: Election Configuration Service ---
SR_ELECTIONS_DB_NAME=sr_elections_db
SR_ELECTIONS_DB_USER=sc_elections_user
SR_ELECTIONS_DB_PASSWORD=123456

# --- SR Module: Pre-electoral Service ---
SR_PRE_ELECTIONS_DB_NAME=sr_pre_elections_db
SR_PRE_ELECTIONS_DB_USER=sr_pre_elections_user
SR_PRE_ELECTIONS_DB_PASSWORD=123456

# --- SR Module: Scrutiny Service ---
SR_SCRUTINY_DB_NAME=sr_scrutiny_db
