{
    auto_https disable_redirects
    local_certs
}

(base) {
	# Catch all to prevent endpoint issues - Augusto
	handle /api/* {
		respond "Forbidden" 403
	}

	# Frontend
	handle {
		reverse_proxy frontend:80
	}
}

(sc-api) {
	# Citizens Service
	@citizen_match {
		path /api/v1/citizen /api/v1/citizen/*
	}

	handle @citizen_match {
		reverse_proxy sc-citizens-service:8080
	}

	# Results Service
	@results_match {
		path /api/v1/results /api/v1/results/*
	}

	handle @results_match {
		reverse_proxy sc-results-service:8080
	}

	# Elections Service
	@elections_match {
		path /api/v1/elections /api/v1/elections/*
	}

	handle @elections_match {
		reverse_proxy sc-elections-service:8080
	}

	# Transparency Service
	@transparency_match {
		path /api/v1/transparency /api/v1/transparency/*
	}

	handle @transparency_match {
		reverse_proxy sc-transparency-service:8080
	}
}

(sr-api) {
	# Pre-elections Service (pre-electoral) — non-v1 routes
	@pre_elections_match {
		path /api/candidaturas /api/candidaturas/* /api/censo /api/censo/* /api/actas /api/actas/* /api/auditoria /api/auditoria/*
	}

	handle @pre_elections_match {
		reverse_proxy sr-pre-elections-service:8080
	}

	# Pre-elections Service — v1 routes (auth, vault, ceremony, jurados, mesas, lista-blanca)
	@pre_elections_v1 {
		path /api/v1/auth /api/v1/auth/* /api/v1/vault /api/v1/vault/* /api/v1/ceremony /api/v1/ceremony/* /api/v1/jurados /api/v1/jurados/* /api/v1/mesas /api/v1/mesas/* /api/v1/lista-blanca /api/v1/lista-blanca/*
	}

	handle @pre_elections_v1 {
		reverse_proxy sr-pre-elections-service:8080
	}

	# Elections Service
	@sr_elections_match {
		path /api/elecciones /api/elecciones/*
	}

	handle @sr_elections_match {
		reverse_proxy sr-elections-service:8080
	}

	# Jury Mock Service
	@jury_match {
		path /api/jurados /api/jurados/* /mock /mock/*
	}

	handle @jury_match {
		reverse_proxy sr-mock-jury-service:8080
	}

	# Scrutiny Service
	@scrutiny_match {
		path /api/v1/e14 /api/v1/e14/*
	}

	handle @scrutiny_match {
		reverse_proxy sr-scrutiny-service:8080
	}

	# Fraude Service (alerts, events, health)
	@fraude_match {
		path /api/v1/fraude /api/v1/fraude/*
	}

	handle @fraude_match {
		reverse_proxy fraude-service:8084
	}

	# Fraud Engine (rules CRUD + evaluate — implemented in ConfiguracionEleccion-service)
	@fraud_engine_match {
		path /api/v1/fraud-engine /api/v1/fraud-engine/*
	}

	handle @fraud_engine_match {
		reverse_proxy sr-elections-service:8080
	}
}

qa.sello-legitimo.site {
    tls internal

	# CORS preflight handler — must come before other handle blocks
	@cors_preflight {
		method OPTIONS
	}

	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
			Access-Control-Allow-Headers "Content-Type, Authorization, X-Mock-Role, X-User-Role, X-User-Id"
			Access-Control-Max-Age "86400"
		}
		respond 204
	}

	# CORS headers on all responses
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Mock-Role, X-User-Role, X-User-Id"
	}

	import sc-api
	import sr-api

	# Dashboard Rol Service
	@dashboard_match {
		path /api/v1/dashboard /api/v1/dashboard/*
	}

	handle @dashboard_match {
		reverse_proxy dashboards-rol-service:8085
	}

	# Es importante que base este de ultimo - Augusto
	import base 
}

electoral-qa.sello-legitimo.site {
	handle {
		reverse_proxy se-servidor-electoral-frontend:3000
	}
}

adminer-qa.sello-legitimo.site {
    tls internal
    
    reverse_proxy adminer:8080 {
        header_up X-Forwarded-Proto {scheme}
    }
}
